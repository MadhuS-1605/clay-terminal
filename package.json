{
  "name": "cc-theme",
  "displayName": "Clay Terminal",
  "description": "A warm dark/light VS Code theme with a coral terminal-inspired accent.",
  "version": "0.6.3",
  "publisher": "astechlabs",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MadhuS-1605/clay-terminal.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Themes"],
  "keywords": ["theme", "color-theme", "dark theme", "light theme", "terminal", "high contrast", "accessibility", "icon theme", "file icons", "product icons", "coral theme"],
  "galleryBanner": {
    "color": "#1a1a19",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Clay Terminal",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-color-theme.json"
      },
      {
        "label": "Clay Terminal Light",
        "uiTheme": "vs",
        "path": "./themes/claude-code-light-color-theme.json"
      },
      {
        "label": "Clay Terminal High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/claude-code-hc-black-color-theme.json"
      },
      {
        "label": "Clay Terminal Light High Contrast",
        "uiTheme": "hc-light",
        "path": "./themes/claude-code-hc-light-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "clay-terminal-icons",
        "label": "Clay Terminal Icons",
        "path": "./themes/clay-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "clay-terminal-product-icons",
        "label": "Clay Terminal Icons",
        "path": "./themes/clay-product-icon-theme.json"
      }
    ]
  }
}
