    "peekViewResult.background": "#0d0d0d",
    "peekViewResult.selectionBackground": "#26261f",
    "peekViewResult.selectionForeground": "#e4e3dd",
    "peekViewResult.matchHighlightBackground": "#d9775733",
    "peekViewTitle.background": "#0d0d0d",
    "peekViewTitleLabel.foreground": "#e4e3dd",
    "peekViewTitleDescription.foreground": "#898781"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#e4e3dd"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7b7974",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#9dbb7d"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#db9300"
      }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#cbcadb"
      }
    },
    {
      "scope": ["punctuation.definition.template-expression"],
      "settings": {
        "foreground": "#629987"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": {
        "foreground": "#ebc9b7"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#d97757"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#898781"
      }
    },
    {
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#c6613f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#e0b473"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#bcd1ca"
      }
    },
    {
      "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": {
        "foreground": "#827dbd"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#e4e3dd"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#c3c2b7"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#cbcadb"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#cbcadb"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#d97757"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#898781"
      }
    },
    {
      "scope": ["invalid"],
      "settings": {
        "foreground": "#ec7e7e"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#d97757",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#898781",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#629987"
      }
    },
    {
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": {
        "foreground": "#0ca30c"
      }
    },
    {
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": {
        "foreground": "#d03b3b"
      }
    },
    {
      "scope": ["markup.changed", "diff.changed"],
      "settings": {
        "foreground": "#db9300"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#e4e3dd",
    "variable.readonly": "#c3c2b7",
    "parameter": "#c3c2b7",
    "property": "#cbcadb",
    "property.readonly": "#cbcadb",
    "function": "#e0b473",
    "method": "#e0b473",
    "class": "#bcd1ca",
    "interface": { "foreground": "#bcd1ca", "italic": true },
    "enum": "#bcd1ca",
    "enumMember": "#ebc9b7",
    "type": "#bcd1ca",
    "typeParameter": "#bcd1ca",
    "namespace": "#629987",
    "keyword": "#d97757",
    "comment": { "foreground": "#7b7974", "italic": true },
    "string": "#9dbb7d",
    "number": "#ebc9b7",
    "decorator": "#827dbd",
    "macro": "#827dbd"
  }
}
