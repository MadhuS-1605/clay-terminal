  "tokenColors": [
    { "settings": { "foreground": "#000000" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#52514e", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#0b6b1e" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#8a5a00" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#4a4593" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#8a5a1e" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#9a4a28" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#20201f" } },
    { "scope": ["variable.language"], "settings": { "foreground": "#7a3820", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#6b4600" } },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type", "entity.name.namespace", "entity.other.inherited-class"],
      "settings": { "foreground": "#0b6b46" }
    },
    { "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#4a4593" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#000000" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#20201f" } },
    { "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#3a3970" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#3a3970" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#9a4a28" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#20201f" } },
    { "scope": ["invalid"], "settings": { "foreground": "#b93535" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#9a4a28", "fontStyle": "bold" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#20201f", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#0b6b46" } },
    { "scope": ["markup.inserted", "diff.inserted"], "settings": { "foreground": "#1a8633" } },
    { "scope": ["markup.deleted", "diff.deleted"], "settings": { "foreground": "#b93535" } },
    { "scope": ["markup.changed", "diff.changed"], "settings": { "foreground": "#8a5a00" } }
  ],
  "semanticTokenColors": {
    "variable": "#000000",
    "variable.readonly": "#20201f",
    "parameter": "#20201f",
    "property": "#3a3970",
    "property.readonly": "#3a3970",
    "function": "#6b4600",
    "method": "#6b4600",
    "class": "#0b6b46",
    "interface": { "foreground": "#0b6b46", "italic": true },
    "enum": "#0b6b46",
    "enumMember": "#8a5a1e",
    "type": "#0b6b46",
    "typeParameter": "#0b6b46",
    "namespace": "#0b6b46",
    "keyword": "#9a4a28",
    "comment": { "foreground": "#52514e", "italic": true },
    "string": "#0b6b1e",
    "number": "#8a5a1e",
    "decorator": "#4a4593",
    "macro": "#4a4593"
  }
}
