    "gitDecoration.deletedResourceForeground": "#b93535",
    "gitDecoration.untrackedResourceForeground": "#3f7562",
    "gitDecoration.ignoredResourceForeground": "#a5a49a",

    "notificationCenterHeader.background": "#f9f9f7",
    "notifications.background": "#ffffff",
    "notifications.border": "#c3c2b7",

    "diffEditor.insertedTextBackground": "#1a863322",
    "diffEditor.insertedLineBackground": "#1a863314",
    "diffEditor.removedTextBackground": "#b9353522",
    "diffEditor.removedLineBackground": "#b9353514",
    "diffEditor.border": "#e1e0d9",
    "diffEditor.diagonalFill": "#c3c2b788",

