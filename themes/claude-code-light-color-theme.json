    "panelTitle.activeForeground": "#0b0b0b",
    "panelTitle.activeBorder": "#c6613f",
    "panelTitle.inactiveForeground": "#7b7974",

    "terminal.background": "#fcfcfb",
    "terminal.foreground": "#0b0b0b",
    "terminal.ansiBlack": "#0b0b0b",
    "terminal.ansiRed": "#b93535",
    "terminal.ansiGreen": "#1a8633",
    "terminal.ansiYellow": "#92400e",
    "terminal.ansiBlue": "#184f95",
    "terminal.ansiMagenta": "#615ba0",
    "terminal.ansiCyan": "#3f7562",
    "terminal.ansiWhite": "#52514e",
    "terminal.ansiBrightBlack": "#a5a49a",
    "terminal.ansiBrightRed": "#d03b3b",
    "terminal.ansiBrightGreen": "#0ca30c",
    "terminal.ansiBrightYellow": "#db9300",
    "terminal.ansiBrightBlue": "#2a78d6",
    "terminal.ansiBrightMagenta": "#827dbd",
    "terminal.ansiBrightCyan": "#629987",
    "terminal.ansiBrightWhite": "#0b0b0b",
