    "peekView.border": "#c6613f",
    "peekViewEditor.background": "#f3f3f0",
    "peekViewEditorGutter.background": "#f3f3f0",
    "peekViewEditor.matchHighlightBackground": "#d9775755",
    "peekViewResult.background": "#f9f9f7",
    "peekViewResult.selectionBackground": "#f0efec",
    "peekViewResult.selectionForeground": "#0b0b0b",
    "peekViewResult.matchHighlightBackground": "#d9775733",
    "peekViewTitle.background": "#f9f9f7",
    "peekViewTitleLabel.foreground": "#0b0b0b",
    "peekViewTitleDescription.foreground": "#52514e"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#0b0b0b"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7b7974",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#2a7a2a"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#92400e"
      }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#5b5a8a"
      }
    },
    {
      "scope": ["punctuation.definition.template-expression"],
      "settings": {
        "foreground": "#3f7562"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": {
        "foreground": "#9a6a44"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#c6613f"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#52514e"
      }
    },
    {
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#a94f31",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8a5a1e"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#3f7562"
      }
    },
    {
      "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": {
        "foreground": "#615ba0"
      }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#0b0b0b"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#383835"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#5b5a8a"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#5b5a8a"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#c6613f"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#52514e"
      }
    },
    {
      "scope": ["invalid"],
      "settings": {
        "foreground": "#b93535"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#c6613f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#52514e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#3f7562"
      }
    },
    {
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": {
        "foreground": "#1a8633"
      }
    },
    {
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": {
        "foreground": "#b93535"
      }
    },
    {
      "scope": ["markup.changed", "diff.changed"],
      "settings": {
        "foreground": "#92400e"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#0b0b0b",
    "variable.readonly": "#383835",
    "parameter": "#383835",
    "property": "#5b5a8a",
    "property.readonly": "#5b5a8a",
    "function": "#8a5a1e",
    "method": "#8a5a1e",
    "class": "#3f7562",
    "interface": { "foreground": "#3f7562", "italic": true },
    "enum": "#3f7562",
    "enumMember": "#9a6a44",
    "type": "#3f7562",
    "typeParameter": "#3f7562",
    "namespace": "#3f7562",
    "keyword": "#c6613f",
    "comment": { "foreground": "#7b7974", "italic": true },
    "string": "#2a7a2a",
    "number": "#9a6a44",
    "decorator": "#615ba0",
    "macro": "#615ba0"
  }
}
