    "input.placeholderForeground": "#a5a49a",
    "inputOption.activeBorder": "#c6613f",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#c3c2b7",

    "button.background": "#c6613f",
    "button.foreground": "#fcfcfb",
    "button.hoverBackground": "#a94f31",

    "badge.background": "#c6613f",
    "badge.foreground": "#fcfcfb",

    "scrollbarSlider.background": "#c3c2b788",
    "scrollbarSlider.hoverBackground": "#a5a49aaa",
    "scrollbarSlider.activeBackground": "#c6613faa",

    "progressBar.background": "#c6613f",

